{
  "name": "queueit/knownuser",
  "description": "Using queueit known user to manage magento integration",
  "type": "magento2-module",
  "version": "1.3.6",
  "license": "MIT",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Queueit\\KnownUser\\": ""
    }
  },
  "require": {
    "queueit/knownuserv3": "^3.6.1",
    "ext-json": "*"
  },
  "require-dev": {
    "magento/framework": "*",
    "magento/module-store": "*",
    "psr/log": "1.1.3",
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com/"
    }
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
